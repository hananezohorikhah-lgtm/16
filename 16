١٦- تابع زیر را نوشته و آزمایش کنید:

 void append(int a[ ], int m, int b[ ], int n); 
تابع بالا n عنصر اول آرایه b را به انتهای m عنصر اول آرایه  الحاق می‌کند. فرض بر این است که آرایه a حداقل به اندازه m+n عنصر جا دارد. برای مثال اگر آرایه a برابر با  {22,33,44,55,66,77,88,99}  و آرایه b نیز برابر با  {20,30,40,50,60,70,80} باشد، آنگاه فراخوانی (a,5,b,3) append باعث می‌شود که آرایه a به شکل {22,33,44,55,66,20,30,40} تغییر کند توجه داشته باشید که آرایه b تغییر نمی‌کند.

پاسخ:
#include<iostream.h>

void append(int a[], int m, int b[], int n);

int main()
{
    int a[8] = {22, 33, 44, 55, 66, 77, 88, 99};
    int b[] = {20, 30, 40, 50, 60, 70, 80};

    append(a, 5, b, 3);

    cout << "The array a is: ";

    for(int i = 0; i < 8; i++)
        cout << a[i] << " ";

    cout << endl;

    return 0;
}

void append(int a[], int m, int b[], int n)
{
    for(int i = 0; i < n; i++)
        a[m + i] = b[i];
}
